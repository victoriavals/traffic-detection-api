# ============================================================
# Traffic Counter API — Environment Variables (CONTOH)
# ============================================================
# Salin file ini menjadi .env lalu isi nilainya.
# JANGAN commit file .env ke git (sudah ada di .gitignore).
# File ini (.env.example) AMAN untuk dicommit — tidak ada nilai asli.
# ============================================================


# ─────────────────────────────────────────────────────────────
# DEPLOYMENT — Ubah bagian ini sesuai setup server Anda
# ─────────────────────────────────────────────────────────────

# URL publik frontend VPS (dipakai untuk membatasi CORS).
# Pisahkan dengan koma jika ada lebih dari satu URL.
# Gunakan "*" untuk mengizinkan semua origin (mode development).
#
# Contoh satu server : CORS_ORIGINS=http://103.12.34.56
# Contoh custom domain: CORS_ORIGINS=https://traffic.example.com
# Contoh multi URL   : CORS_ORIGINS=http://103.12.34.56,https://traffic.example.com
# Contoh development : CORS_ORIGINS=*
#
CORS_ORIGINS=*


# ─────────────────────────────────────────────────────────────
# DATABASE — MongoDB
# ─────────────────────────────────────────────────────────────

# URI koneksi MongoDB (wajib diisi).
# Format lokal    : mongodb://localhost:27017
# Format dengan auth: mongodb://user:password@host:port
# Format Atlas    : mongodb+srv://user:password@cluster.mongodb.net
#
MONGO_URI=mongodb://user:password@host:port

# Nama database yang digunakan.
MONGO_DB_NAME=traffic_counter


# ─────────────────────────────────────────────────────────────
# EZVIZ — Integrasi kamera cloud EZVIZ (opsional)
# Hanya diperlukan jika fitur EZVIZ digunakan.
# Dapatkan App Key & Secret di: https://isgpopen.ezviz.com/console/appkey.html
# ─────────────────────────────────────────────────────────────

EZVIZ_APP_KEY=your_app_key_here
EZVIZ_APP_SECRET=your_app_secret_here
