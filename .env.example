# MongoDB Connection
MONGO_URI=mongodb://user:password@host:port
MONGO_DB_NAME=traffic_counter

# EZVIZ Cloud API Credentials
# Dapatkan dari https://isgpopen.ezviz.com/console/appkey.html
EZVIZ_APP_KEY=your_app_key_here
EZVIZ_APP_SECRET=your_app_secret_here

# Logging format: "text" (human-readable, default) | "json" (single-line JSON, for Grafana/Loki)
LOG_FORMAT=text
